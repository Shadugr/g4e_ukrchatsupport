<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Authors>justscribe</Authors>
        <Company>G4E</Company>
        <Version>1.0.0.35</Version>
        <Description>A Dalamud plugin to support ukrainian symbols in game chat.</Description>
        <Copyright>Gaming4Eternity Ukrainian Community</Copyright>
        <PackageProjectUrl>https://github.com/Shadugr/g4e_ukrchatsupport</PackageProjectUrl>
        <RootNamespace>UkrChatSupportPlugin</RootNamespace>
        <AssemblyVersion>1.0.0.35</AssemblyVersion>
        <FileVersion>1.0.0.35</FileVersion>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <None Update="G4EUkrChatSupport.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
